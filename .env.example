# Copy to .env.local for local development. All values below are placeholders for the
# mock service layer — no real network calls are made in this frontend-only scaffold.

# "testnet" | "mainnet" — scopes which mock agent dataset is shown
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Placeholder Horizon endpoint, read by lib/services only, never called in mock mode
NEXT_PUBLIC_HORIZON_URL=https://horizon-testnet.stellar.org

# Placeholder Smart Account Kit app identifier for the mocked passkey connect flow
NEXT_PUBLIC_SMART_ACCOUNT_KIT_APP_ID=orbitflow-dev

# Artificial delay (ms) the mock service layer waits before resolving, to exercise loading states
NEXT_PUBLIC_MOCK_LATENCY_MS=400
